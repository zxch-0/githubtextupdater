# Local development only — copy to .env and fill in.
# On Render these are provided by render.yaml (SESSION_SECRET is generated for you).

# Secret used to encrypt the session cookie that stores the GitHub token.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-with-openssl-rand-hex-32

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Optional limits
MAX_SPEC_BYTES=4194304
MAX_FILES=200
MAX_FILE_BYTES=1048576
