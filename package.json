{
  "name": "github-text-updater",
  "version": "1.0.0",
  "private": true,
  "description": "Paste a text block describing files, create them in a GitHub repo, then open and merge the pull request.",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/routes/api.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "express": "^4.22.3"
  }
}
